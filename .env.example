# ============================================================================
# HEC Smart Navigator — variables d'environnement requises (Vite)
#
# Copiez ce fichier en `.env` (ou `.env.local`) à la racine du projet, puis
# renseignez de VRAIES valeurs. Aucune clé réelle n'est fournie ici : ce
# fichier ne fait que documenter ce que le code lit déjà (voir
# src/lib/supabase.ts et src/lib/map-config.ts). Redémarrez `vite` après
# toute modification de ces variables (Vite ne les recharge pas à chaud).
# ============================================================================

# --- Supabase (obligatoire) -------------------------------------------------
# Project Settings > API, dans votre projet Supabase.
VITE_SUPABASE_URL=https://lvjjjdibgktttldrdeqn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_JOqXCftn5rSCXIcNEfgH_g_TsPkyqZU


# --- Cartographie (obligatoire) ---------------------------------------------
# Un fournisseur DOIT être choisi explicitement — src/lib/map-config.ts lève
# volontairement une erreur claire (MapConfigError) tant que ce n'est pas
# fait, plutôt que d'afficher une fausse carte. Valeurs acceptées :
#   maptiler | mapbox | esri | custom

VITE_MAP_PROVIDER=maptiler

# Requis pour maptiler / mapbox / esri (inutile pour "custom").
# - MapTiler : compte gratuit sur maptiler.com > Clés API
# - Mapbox   : compte sur mapbox.com > Tokens d'accès
# - Esri     : compte developers.arcgis.com > clé API (basemap styles)
VITE_MAP_API_KEY=ILtNB1nSIo8VSEA0Sob9 


# Requis uniquement si VITE_MAP_PROVIDER=custom : URL complète d'un
# style.json compatible MapLibre (ex. votre propre serveur de tuiles).
# VITE_MAP_STYLE_URL=

# --- Surcharges optionnelles -------------------------------------------------
# Par mode d'affichage (plan / satellite / hybrid / topo / dark), si l'ID de
# style par défaut de map-config.ts ne convient pas pour votre compte :
# VITE_MAP_STYLE_ID_PLAN=
# VITE_MAP_STYLE_ID_SATELLITE=
# VITE_MAP_STYLE_ID_HYBRID=
# VITE_MAP_STYLE_ID_TOPO=
# VITE_MAP_STYLE_ID_DARK=
#
# Équivalent pour le fournisseur "custom" (une URL de style par mode) :
# VITE_MAP_STYLE_URL_PLAN=
# VITE_MAP_STYLE_URL_SATELLITE=
# VITE_MAP_STYLE_URL_HYBRID=
# VITE_MAP_STYLE_URL_TOPO=
# VITE_MAP_STYLE_URL_DARK=
