# ============================================================================
# HEC LOCALISATION — VARIABLES D'ENVIRONNEMENT
# Vite + React + Supabase + MapTiler + OpenRouteService
#
# Fichier : .env.local
# Redémarrer Vite après chaque modification.
# Ne jamais publier les clés API ou les secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE — Base de données et authentification
# ----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_SUPABASE_ANON

# ----------------------------------------------------------------------------
# 2. CARTOGRAPHIE — MAPTILER
# ----------------------------------------------------------------------------

VITE_MAP_PROVIDER=maptiler
VITE_MAP_API_KEY=VOTRE_CLE_MAPTILER

# ----------------------------------------------------------------------------
# 3. ITINERAIRES PIETONS — MODE PROXY SECURISE
# ----------------------------------------------------------------------------

VITE_ROUTING_PROVIDER=proxy

# Ne pas ajouter VITE_ROUTING_API_KEY en mode proxy.
# La clé OpenRouteService doit être configurée côté Supabase :
# ORS_API_KEY=VOTRE_CLE_OPENROUTESERVICE

# ----------------------------------------------------------------------------
# 4. GEOCODAGE — RECHERCHE DE LIEUX ET D'ADRESSES
# ----------------------------------------------------------------------------

VITE_GEOCODER=maptiler

# ----------------------------------------------------------------------------
# 5. STYLES CARTOGRAPHIQUES OPTIONNELS
# Décommenter uniquement si une surcharge est nécessaire.
# ----------------------------------------------------------------------------

# VITE_MAP_STYLE_ID_PLAN=
# VITE_MAP_STYLE_ID_SATELLITE=
# VITE_MAP_STYLE_ID_HYBRID=
# VITE_MAP_STYLE_ID_TOPO=
# VITE_MAP_STYLE_ID_DARK=

# ============================================================================
# FIN DE CONFIGURATION
# ============================================================================





