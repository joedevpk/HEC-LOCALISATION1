  (SELECT count(*) FROM route_nodes)                                AS nb_route_nodes,
  (SELECT count(*) FROM route_segments)                             AS nb_route_segments,
  (SELECT count(*) FROM route_nodes WHERE archived_at IS NULL)      AS nb_nodes_actifs,
