-- Cohérence campus : doit renvoyer 0 ligne. Toute ligne retournée signale
-- un segment dont une extrémité appartient à un autre campus que le
-- segment lui-même.
SELECT
  s.id AS segment_id,
  s.campus_id AS segment_campus,
  nf.campus_id AS from_node_campus,
  nt.campus_id AS to_node_campus
FROM route_segments s
JOIN route_nodes nf ON nf.id = s.from_node
JOIN route_nodes nt ON nt.id = s.to_node
WHERE s.campus_id <> nf.campus_id OR s.campus_id <> nt.campus_id;



SELECT l.id, l.name, l.kind, l.lng, l.lat, l.created_at, b.name AS building_name
FROM locations l
JOIN buildings b ON b.id = l.building_id
WHERE b.campus_id = '00000000-0000-4000-a000-000000000c01'
  AND l.archived_at IS NULL AND b.archived_at IS NULL
ORDER BY l.created_at ASC
LIMIT 5;

