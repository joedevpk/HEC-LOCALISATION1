-- =====================================================================
-- Réseau piéton de démonstration (route_nodes / route_segments)
-- HEC Smart Navigator
--
-- - Ne crée aucun campus, ne supprime aucune donnée existante.
-- - Idempotent : IDs fixes + ON CONFLICT DO UPDATE → ré-exécutable sans
--   créer de doublons.
-- - Réutilise les vraies coordonnées d'une entrée / d'un lieu existants
--   (table locations) si elles existent déjà pour ce campus ; sinon
--   repli sur des coordonnées DE DÉMONSTRATION calculées autour de
--   campuses.center_lng / center_lat (clairement marquées ci-dessous).
-- =====================================================================

-- Fonction utilitaire : distance approx. en mètres entre deux points
-- lng/lat (formule haversine). Aucune extension requise. Purement
-- additive — ne touche à aucune table existante.
CREATE OR REPLACE FUNCTION route_seed_haversine_m(
  lng1 double precision, lat1 double precision,
  lng2 double precision, lat2 double precision
) RETURNS double precision
LANGUAGE sql
IMMUTABLE
AS $$
  SELECT 6371000 * 2 * asin(
    sqrt(
      power(sin(radians(lat2 - lat1) / 2), 2) +
      cos(radians(lat1)) * cos(radians(lat2)) *
      power(sin(radians(lng2 - lng1) / 2), 2)
    )
  );
$$;

DO $$
DECLARE
  v_campus_id   uuid;
  v_campus_lng  double precision;
  v_campus_lat  double precision;

  -- Entrée réelle (locations.kind = 'entrance') si elle existe pour ce
  -- campus, sinon repli DEMO.
  v_entry_lng   double precision;
  v_entry_lat   double precision;

  -- Destination réelle (un lieu non-entrée) si elle existe, sinon repli DEMO.
  v_dest_lng    double precision;
  v_dest_lat    double precision;

  -- Vecteur entrée -> destination, utilisé pour placer les nœuds
  -- intermédiaires PAR INTERPOLATION (donc toujours cohérents avec la
  -- position réelle de l'entrée et de la destination, où qu'elles soient).
  v_dx double precision;
  v_dy double precision;
  v_perp_lng double precision;
  v_perp_lat double precision;

  v_a_lng double precision; v_a_lat double precision;
  v_b_lng double precision; v_b_lat double precision;
  v_c_lng double precision; v_c_lat double precision;
  v_d_lng double precision; v_d_lat double precision;
  v_e_lng double precision; v_e_lat double precision;

  -- IDs fixes, namespace dédié (a200 = nœuds, a201 = segments) pour ne
  -- jamais entrer en collision avec les IDs du script de données
  -- d'exemple bâtiment/salle (namespace a000/f000/e000/0000...101).
  v_n_entree uuid := '00000000-0000-4000-a200-000000000001';
  v_n_a      uuid := '00000000-0000-4000-a200-000000000002';
  v_n_b      uuid := '00000000-0000-4000-a200-000000000003';
  v_n_c      uuid := '00000000-0000-4000-a200-000000000004';
  v_n_d      uuid := '00000000-0000-4000-a200-000000000005';
  v_n_e      uuid := '00000000-0000-4000-a200-000000000006';
  v_n_dest   uuid := '00000000-0000-4000-a200-000000000007';

  v_seg_entree_a uuid := '00000000-0000-4000-a201-000000000001';
  v_seg_a_b      uuid := '00000000-0000-4000-a201-000000000002';
  v_seg_b_c      uuid := '00000000-0000-4000-a201-000000000003';
  v_seg_b_d      uuid := '00000000-0000-4000-a201-000000000004';
  v_seg_c_e      uuid := '00000000-0000-4000-a201-000000000005';
  v_seg_d_e      uuid := '00000000-0000-4000-a201-000000000006';
  v_seg_d_dest   uuid := '00000000-0000-4000-a201-000000000007';
BEGIN
  -- ------------------------------------------------------------------
  -- 1) Récupère le campus existant (le plus ancien) — jamais créé ici.
  -- ------------------------------------------------------------------
  SELECT id, center_lng, center_lat
    INTO v_campus_id, v_campus_lng, v_campus_lat
  FROM campuses
  ORDER BY created_at ASC
  LIMIT 1;

  IF v_campus_id IS NULL THEN
    RAISE EXCEPTION
      'Aucun campus trouvé : créez d''abord un campus (table campuses) avant d''exécuter ce script.';
  END IF;

  -- ------------------------------------------------------------------
  -- 2) Entrée : réutilise une location réelle kind='entrance' liée à ce
  --    campus (via buildings.campus_id) si elle existe.
  -- ------------------------------------------------------------------
  SELECT l.lng, l.lat
    INTO v_entry_lng, v_entry_lat
  FROM locations l
  JOIN buildings b ON b.id = l.building_id
  WHERE b.campus_id = v_campus_id
    AND l.kind = 'entrance'
    AND l.archived_at IS NULL
    AND b.archived_at IS NULL
  ORDER BY l.created_at ASC
  LIMIT 1;

  IF v_entry_lng IS NULL THEN
    -- Repli DEMO — à remplacer par la vraie entrée du campus une fois
    -- saisie (≈ 45 m au sud-ouest du centre du campus).
    v_entry_lng := v_campus_lng - 0.00030;
    v_entry_lat := v_campus_lat - 0.00025;
  END IF;

  -- ------------------------------------------------------------------
  -- 3) Destination : réutilise un lieu réel (salle/bureau/POI, donc
  --    kind <> 'entrance') déjà présent pour ce campus si disponible.
  -- ------------------------------------------------------------------
  SELECT l.lng, l.lat
    INTO v_dest_lng, v_dest_lat
  FROM locations l
  JOIN buildings b ON b.id = l.building_id
  WHERE b.campus_id = v_campus_id
    AND l.kind <> 'entrance'
    AND l.archived_at IS NULL
    AND b.archived_at IS NULL
  ORDER BY l.created_at ASC
  LIMIT 1;

  IF v_dest_lng IS NULL THEN
    -- Repli DEMO — à remplacer par une vraie salle une fois saisie
    -- (≈ 45 m au nord-est du centre du campus).
    v_dest_lng := v_campus_lng + 0.00035;
    v_dest_lat := v_campus_lat + 0.00030;
  END IF;

  -- Garde-fou (cas dégénéré improbable) : entrée et destination identiques.
  IF v_dest_lng = v_entry_lng AND v_dest_lat = v_entry_lat THEN
    v_dest_lng := v_dest_lng + 0.00030;
    v_dest_lat := v_dest_lat + 0.00025;
  END IF;

  -- ------------------------------------------------------------------
  -- 4) Nœuds intermédiaires (Carrefour A/B/C/E, Corridor D) : POSITIONS
  --    DE DÉMONSTRATION calculées par interpolation entre l'entrée et
  --    la destination (réelles ou DEMO ci-dessus) — donc toujours
  --    cohérentes géographiquement, quel que soit l'emplacement réel du
  --    campus. À ajuster plus tard depuis l'outil admin de tracé des
  --    chemins pour suivre les vraies allées.
  -- ------------------------------------------------------------------
  v_dx := v_dest_lng - v_entry_lng;
  v_dy := v_dest_lat - v_entry_lat;
  v_perp_lng := -v_dy * 0.3;
  v_perp_lat :=  v_dx * 0.3;

  v_a_lng := v_entry_lng + 0.15 * v_dx;  v_a_lat := v_entry_lat + 0.15 * v_dy;
  v_b_lng := v_entry_lng + 0.40 * v_dx;  v_b_lat := v_entry_lat + 0.40 * v_dy;
  v_d_lng := v_entry_lng + 0.65 * v_dx;  v_d_lat := v_entry_lat + 0.65 * v_dy;
  v_c_lng := v_b_lng + v_perp_lng;       v_c_lat := v_b_lat + v_perp_lat;
  v_e_lng := v_d_lng + v_perp_lng;       v_e_lat := v_d_lat + v_perp_lat;

  -- ------------------------------------------------------------------
  -- 5) Nœuds. Schéma :
  --    ENTRÉE - A - B ─ C
  --                 │   │
  --                 D ─ E
  --                 │
  --            DESTINATION
  -- ------------------------------------------------------------------
  INSERT INTO route_nodes (id, campus_id, lng, lat, type, label, archived_at)
  VALUES
    (v_n_entree, v_campus_id, v_entry_lng, v_entry_lat, 'entrance',     'Entrée principale',  NULL),
    (v_n_a,      v_campus_id, v_a_lng,     v_a_lat,     'intersection', 'Carrefour A',        NULL),
    (v_n_b,      v_campus_id, v_b_lng,     v_b_lat,     'intersection', 'Carrefour B',        NULL),
    (v_n_c,      v_campus_id, v_c_lng,     v_c_lat,     'intersection', 'Carrefour C',        NULL),
    (v_n_d,      v_campus_id, v_d_lng,     v_d_lat,     'corridor',     'Corridor principal', NULL),
    (v_n_e,      v_campus_id, v_e_lng,     v_e_lat,     'intersection', 'Carrefour E',        NULL),
    (v_n_dest,   v_campus_id, v_dest_lng,  v_dest_lat,  'poi',          'Salle / Destination', NULL)
  ON CONFLICT (id) DO UPDATE SET
    campus_id   = EXCLUDED.campus_id,
    lng         = EXCLUDED.lng,
    lat         = EXCLUDED.lat,
    type        = EXCLUDED.type,
    label       = EXCLUDED.label,
    archived_at = EXCLUDED.archived_at;

  -- ------------------------------------------------------------------
  -- 6) Segments — distance calculée (jamais en dur) à partir des
  --    coordonnées réelles des deux nœuds.
  -- ------------------------------------------------------------------
  INSERT INTO route_segments (id, campus_id, from_node, to_node, distance, accessible, segment_type, archived_at)
  VALUES
    (v_seg_entree_a, v_campus_id, v_n_entree, v_n_a,
     route_seed_haversine_m(v_entry_lng, v_entry_lat, v_a_lng, v_a_lat), true, 'walkway', NULL),
    (v_seg_a_b, v_campus_id, v_n_a, v_n_b,
     route_seed_haversine_m(v_a_lng, v_a_lat, v_b_lng, v_b_lat), true, 'walkway', NULL),
    (v_seg_b_c, v_campus_id, v_n_b, v_n_c,
     route_seed_haversine_m(v_b_lng, v_b_lat, v_c_lng, v_c_lat), true, 'walkway', NULL),
    (v_seg_b_d, v_campus_id, v_n_b, v_n_d,
     route_seed_haversine_m(v_b_lng, v_b_lat, v_d_lng, v_d_lat), true, 'corridor', NULL),
    (v_seg_c_e, v_campus_id, v_n_c, v_n_e,
     route_seed_haversine_m(v_c_lng, v_c_lat, v_e_lng, v_e_lat), true, 'walkway', NULL),
    (v_seg_d_e, v_campus_id, v_n_d, v_n_e,
     route_seed_haversine_m(v_d_lng, v_d_lat, v_e_lng, v_e_lat), true, 'corridor', NULL),
    (v_seg_d_dest, v_campus_id, v_n_d, v_n_dest,
     route_seed_haversine_m(v_d_lng, v_d_lat, v_dest_lng, v_dest_lat), true, 'corridor', NULL)
  ON CONFLICT (id) DO UPDATE SET
    campus_id     = EXCLUDED.campus_id,
    from_node     = EXCLUDED.from_node,
    to_node       = EXCLUDED.to_node,
    distance      = EXCLUDED.distance,
    accessible    = EXCLUDED.accessible,
    segment_type  = EXCLUDED.segment_type,
    archived_at   = EXCLUDED.archived_at;

  RAISE NOTICE 'Réseau piéton créé/mis à jour pour le campus %: 7 nœuds, 7 segments.', v_campus_id;
END $$;

